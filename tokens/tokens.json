{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Chememan Modern Design System",
    "version": "1.0.0",
    "updated": "2026-05-10",
    "source": "Chememan Corporate Identity Standard Manual",
    "scope": "Web, scrollable HTML decks, PPTX presentations"
  },

  "color": {
    "_note_primary_tier": "Working palette = green + blue + brown (user direction 2026-05-10). Official CI book p.12 only labels Forest/Amber/White/Black as primary; Blue is officially secondary but is treated as primary-tier here because the Chememan modern aesthetic leans on the green/blue/brown triad.",
    "brand": {
      "forest":  { "value": "#00522C", "rgb": "0 82 44",   "cmyk": "100/40/100/40", "role": "Primary 1 — Chememan green. Hero surfaces, headline accents, primary CTA fill." },
      "blue":    { "value": "#3C60A5", "rgb": "60 96 165", "cmyk": "84/67/5/0",     "role": "Primary 2 — Chememan blue. Tech / data / digital surfaces, secondary glow, info accents. Pairs with sky #5ECDF6 for highlights and navy #223562 for deep backgrounds." },
      "amber":   { "value": "#745021", "rgb": "116 80 33", "cmyk": "42/62/100/34",  "role": "Primary 3 — Chememan brown (mascot scarf). Editorial accents, warm tints, badge fills." },
      "white":   { "value": "#FFFFFF", "rgb": "255 255 255","role": "Primary surface in light mode; logo knockout color." },
      "black":   { "value": "#000000", "rgb": "0 0 0",      "role": "Mono logo treatment; never as wide background unless brand glass dark mode." }
    },

    "secondary": {
      "navy":     { "value": "#223562", "rgb": "34 53 98",   "cmyk": "98/87/34/24" },
      "blue":     { "value": "#3C60A5", "rgb": "60 96 165",  "cmyk": "84/67/5/0" },
      "sky":      { "value": "#5ECDF6", "rgb": "94 205 246", "cmyk": "54/0/0/0" },
      "jade":     { "value": "#388062", "rgb": "56 128 98",  "cmyk": "79/25/71/12" },
      "emerald":  { "value": "#00AC69", "rgb": "0 172 105",  "cmyk": "100/0/82/0" },
      "mint":     { "value": "#20BB8D", "rgb": "32 187 141", "cmyk": "74/0/61/0" },
      "olive":    { "value": "#6F5229", "rgb": "111 82 41",  "cmyk": "44/58/91/35" },
      "copper":   { "value": "#AD6637", "rgb": "173 102 55", "cmyk": "25/64/88/12" },
      "gold":     { "value": "#CD9D3F", "rgb": "205 157 63", "cmyk": "20/38/89/1" },
      "yellow":   { "value": "#FFD100", "rgb": "255 209 0",  "cmyk": "1/16/100/0" },
      "peach":    { "value": "#F6CEB7", "rgb": "246 206 183","cmyk": "2/21/25/0" },
      "coral":    { "value": "#E8676A", "rgb": "232 103 106","cmyk": "4/74/50/0" },
      "mist":     { "value": "#EFEFEF", "rgb": "239 239 239","cmyk": "5/3/3/0" },
      "grey":     { "value": "#7F7F7F", "rgb": "127 127 127","cmyk": "52/43/43/8" },
      "charcoal": { "value": "#333333", "rgb": "51 51 51",   "cmyk": "69/63/62/58" }
    },

    "tints": {
      "forest-100": "#E5EDE9",
      "forest-200": "#BFD3C8",
      "forest-300": "#7FA897",
      "forest-400": "#3F7E66",
      "forest-500": "#00522C",
      "forest-600": "#00421F",
      "forest-700": "#003118",
      "forest-800": "#00210F",
      "forest-900": "#001008",
      "blue-100":   "#E1E8F4",
      "blue-200":   "#B8C7E4",
      "blue-300":   "#8AA1CF",
      "blue-400":   "#5C7BBA",
      "blue-500":   "#3C60A5",
      "blue-600":   "#2F4D87",
      "blue-700":   "#223562",
      "blue-800":   "#161F3C",
      "blue-900":   "#0A0F1F",
      "amber-100":  "#F1ECE3",
      "amber-200":  "#D6C7A6",
      "amber-300":  "#A8916A",
      "amber-400":  "#8F6A3D",
      "amber-500":  "#745021",
      "amber-600":  "#5C3F19"
    },

    "semantic": {
      "bg-canvas-light":   "#FFFFFF",
      "bg-canvas-dark":    "#0B1A12",
      "bg-elevated-light": "#F7F8F7",
      "bg-elevated-dark":  "#0F2218",
      "fg-primary-light":  "#0B1A12",
      "fg-primary-dark":   "#FFFFFF",
      "fg-muted-light":    "#5C6B62",
      "fg-muted-dark":     "#9FB3A8",
      "border-soft-light": "rgba(11,26,18,0.08)",
      "border-soft-dark":  "rgba(255,255,255,0.10)",
      "accent-primary":    "#00522C",
      "accent-secondary":  "#745021",
      "danger":  "#E8676A",
      "warning": "#CD9D3F",
      "success": "#20BB8D",
      "info":    "#3C60A5"
    },

    "gradient": {
      "forest-glow":     "radial-gradient(ellipse at top, #1F8B5A 0%, #00522C 35%, #001008 100%)",
      "blue-glow":       "radial-gradient(ellipse at top, #5ECDF6 0%, #3C60A5 35%, #0A0F1F 100%)",
      "amber-glow":      "radial-gradient(ellipse at top, #C6913E 0%, #745021 40%, #1A0F05 100%)",
      "forest-amber":    "linear-gradient(135deg, #00522C 0%, #745021 100%)",
      "forest-blue":     "linear-gradient(135deg, #00522C 0%, #3C60A5 100%)",
      "blue-amber":      "linear-gradient(135deg, #3C60A5 0%, #745021 100%)",
      "tricolor":        "linear-gradient(135deg, #00522C 0%, #3C60A5 50%, #745021 100%)",
      "midnight":        "linear-gradient(180deg, #0A0F1F 0%, #161F3C 50%, #001008 100%)",
      "sunrise-jade":    "linear-gradient(135deg, #00522C 0%, #20BB8D 50%, #5ECDF6 100%)",
      "headline":        "linear-gradient(135deg, #FFFFFF 0%, #5ECDF6 60%, #20BB8D 100%)",
      "hero-mesh":       "radial-gradient(at 20% 10%, #00522C 0%, transparent 45%), radial-gradient(at 80% 0%, #3C60A5 0%, transparent 50%), radial-gradient(at 50% 90%, #745021 0%, transparent 50%), radial-gradient(at 90% 80%, #20BB8D 0%, transparent 40%), #050E1A"
    }
  },

  "font": {
    "family": {
      "primary":    "'FC Minimal', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "primary-th": "'FC Minimal', 'IBM Plex Sans Thai', 'Noto Sans Thai', sans-serif",
      "mono":       "'JetBrains Mono', 'Fira Code', ui-monospace, monospace"
    },
    "weight": {
      "thin": 100, "extralight": 200, "light": 300, "regular": 400,
      "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900
    },
    "size": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "lg":   "1.125rem",
      "xl":   "1.25rem",
      "2xl":  "1.5rem",
      "3xl":  "1.875rem",
      "4xl":  "2.25rem",
      "5xl":  "3rem",
      "6xl":  "3.75rem",
      "7xl":  "4.5rem",
      "8xl":  "6rem",
      "9xl":  "8rem"
    },
    "leading": {
      "tight":   "1.05",
      "snug":    "1.2",
      "normal":  "1.5",
      "relaxed": "1.7"
    },
    "tracking": {
      "tighter": "-0.04em",
      "tight":   "-0.02em",
      "normal":  "0",
      "wide":    "0.02em",
      "wider":   "0.08em",
      "widest":  "0.16em"
    }
  },

  "space": {
    "0": "0",      "px": "1px",   "0.5": "2px",  "1": "4px",   "1.5": "6px",
    "2": "8px",    "3": "12px",   "4": "16px",   "5": "20px",  "6": "24px",
    "8": "32px",   "10": "40px",  "12": "48px",  "14": "56px", "16": "64px",
    "20": "80px",  "24": "96px",  "28": "112px", "32": "128px","40": "160px",
    "48": "192px", "56": "224px", "64": "256px"
  },

  "radius": {
    "none": "0",
    "xs":   "4px",
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "24px",
    "2xl":  "32px",
    "3xl":  "48px",
    "full": "9999px"
  },

  "shadow": {
    "xs":    "0 1px 2px rgba(0,16,8,0.06)",
    "sm":    "0 2px 4px rgba(0,16,8,0.08), 0 1px 2px rgba(0,16,8,0.04)",
    "md":    "0 8px 16px -4px rgba(0,16,8,0.10), 0 2px 4px rgba(0,16,8,0.06)",
    "lg":    "0 20px 40px -12px rgba(0,16,8,0.16), 0 8px 16px -8px rgba(0,16,8,0.08)",
    "xl":    "0 32px 64px -16px rgba(0,16,8,0.20), 0 12px 24px -12px rgba(0,16,8,0.10)",
    "2xl":   "0 48px 96px -24px rgba(0,16,8,0.28)",
    "glow-forest":  "0 0 32px rgba(0,82,44,0.45), 0 0 4px rgba(32,187,141,0.30)",
    "glow-amber":   "0 0 32px rgba(116,80,33,0.40), 0 0 4px rgba(205,157,63,0.30)",
    "inset-soft":   "inset 0 1px 0 rgba(255,255,255,0.10), inset 0 -1px 0 rgba(0,0,0,0.04)"
  },

  "glass": {
    "_recipe": "Bright frosted-white tint (15–28% alpha) + strong blur (24–32px) + visible top-edge inset highlight. Updated 2026-05-10: prior version was too dark; default is now bright frost so background colors bleed through softly while text stays readable.",

    "default": {
      "bg":              "rgba(255,255,255,0.18)",
      "border":          "1px solid rgba(255,255,255,0.35)",
      "backdrop-filter": "blur(24px) saturate(180%)",
      "shadow":          "0 8px 32px -4px rgba(0,16,8,0.18), inset 0 1px 0 rgba(255,255,255,0.45), inset 0 -1px 0 rgba(255,255,255,0.10)"
    },
    "heavy": {
      "bg":              "rgba(255,255,255,0.28)",
      "border":          "1px solid rgba(255,255,255,0.45)",
      "backdrop-filter": "blur(32px) saturate(180%)",
      "shadow":          "0 12px 40px -6px rgba(0,16,8,0.22), inset 0 1px 0 rgba(255,255,255,0.55)"
    },
    "light": {
      "bg":              "rgba(255,255,255,0.65)",
      "border":          "1px solid rgba(255,255,255,0.85)",
      "backdrop-filter": "blur(20px) saturate(180%)",
      "shadow":          "0 12px 32px -8px rgba(0,16,8,0.10), inset 0 1px 0 rgba(255,255,255,1)"
    },
    "tint-forest": {
      "bg":              "linear-gradient(135deg, rgba(0,82,44,0.10), rgba(255,255,255,0.20))",
      "border":          "1px solid rgba(255,255,255,0.40)",
      "backdrop-filter": "blur(24px) saturate(180%)",
      "shadow":          "0 12px 36px -6px rgba(0,82,44,0.20), inset 0 1px 0 rgba(255,255,255,0.5)"
    },
    "tint-blue": {
      "bg":              "linear-gradient(135deg, rgba(60,96,165,0.15), rgba(255,255,255,0.20))",
      "border":          "1px solid rgba(255,255,255,0.42)",
      "backdrop-filter": "blur(24px) saturate(180%)",
      "shadow":          "0 12px 36px -6px rgba(60,96,165,0.25), inset 0 1px 0 rgba(255,255,255,0.55)"
    },
    "tint-amber": {
      "bg":              "linear-gradient(135deg, rgba(116,80,33,0.15), rgba(255,255,255,0.20))",
      "border":          "1px solid rgba(255,255,255,0.40)",
      "backdrop-filter": "blur(24px) saturate(180%)",
      "shadow":          "0 12px 36px -6px rgba(116,80,33,0.25), inset 0 1px 0 rgba(255,255,255,0.5)"
    }
  },

  "blur": { "sm": "8px", "md": "16px", "lg": "24px", "xl": "40px", "2xl": "64px" },

  "motion": {
    "duration": {
      "instant": "100ms", "fast": "180ms", "base": "240ms",
      "slow": "400ms",    "slower": "640ms", "cinematic": "1200ms"
    },
    "easing": {
      "standard":  "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate":"cubic-bezier(0, 0, 0.2, 1)",
      "accelerate":"cubic-bezier(0.4, 0, 1, 1)",
      "spring":    "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear":    "linear"
    }
  },

  "breakpoint": {
    "sm":  "640px",
    "md":  "768px",
    "lg":  "1024px",
    "xl":  "1280px",
    "2xl": "1536px",
    "slide-16-9": "1920x1080",
    "slide-9-16": "1080x1920"
  },

  "z": {
    "base": 0, "raised": 10, "sticky": 20, "overlay": 30,
    "modal": 40, "popover": 50, "toast": 60, "tooltip": 70
  }
}
