{
  "_meta": {
    "purpose": "PptxGenJS-friendly token mirror. Use these values when building .pptx via the pptx skill.",
    "spec": "PptxGenJS expects HEX without #, fontFace as a single string, and points (pt) for spacing/font sizes."
  },

  "_color_tier_note": "Working primary tier = green + blue + brown (FOREST, BLUE, AMBER). Sky + navy are secondary blues for highlights/depth. Other entries are tertiary accents.",
  "color": {
    "FOREST":   "00522C",
    "BLUE":     "3C60A5",
    "AMBER":    "745021",
    "WHITE":    "FFFFFF",
    "BLACK":    "000000",
    "NAVY":     "223562",
    "SKY":      "5ECDF6",
    "JADE":     "388062",
    "MINT":     "20BB8D",
    "EMERALD":  "00AC69",
    "GOLD":     "CD9D3F",
    "COPPER":   "AD6637",
    "PEACH":    "F6CEB7",
    "CORAL":    "E8676A",
    "YELLOW":   "FFD100",
    "MIST":     "EFEFEF",
    "GREY":     "7F7F7F",
    "CHARCOAL": "333333",
    "BG_DARK":  "0B1A12",
    "BG_DARK_ELEVATED": "0F2218",
    "BG_BLUE_DARK": "0A0F1F",
    "BG_BLUE_DARK_ELEVATED": "161F3C"
  },

  "font": {
    "primary":      "FC Minimal",
    "primary_safe": "Inter",
    "fallback":     "Calibri",
    "thai":         "FC Minimal",
    "mono":         "Consolas"
  },

  "size_pt": {
    "display":  60,
    "h1":       40,
    "h2":       32,
    "h3":       24,
    "h4":       20,
    "lead":     18,
    "body":     16,
    "caption":  12,
    "footnote": 10
  },

  "slide_layout": {
    "widescreen_16x9_in": { "w": 13.333, "h": 7.5 },
    "vertical_9x16_in":   { "w": 7.5,    "h": 13.333 },
    "margins_in": { "x": 0.6, "y": 0.5 },
    "gutter_in":  0.25,
    "safe_zone_in": { "left": 0.75, "right": 0.75, "top": 0.6, "bottom": 0.6 }
  },

  "card_style": {
    "fill":        { "color": "0F2218", "transparency": 30 },
    "line":        { "color": "20BB8D", "width": 0.75, "transparency": 70 },
    "shadow":      { "type": "outer", "blur": 24, "offset": 6, "angle": 90, "color": "000000", "opacity": 0.45 },
    "rectRadius":  0.18
  },

  "logo_paths": {
    "full":      "design-system/chememan/assets/logo/chememan-full-logo.png",
    "character": "design-system/chememan/assets/characters/chememan-character.png"
  }
}
